{
    "name": "nyx-lab",
    "description": "Nyx Lab",
    "version": "1.0.0",
    "author": "Jérôme Odier",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "https://github.com/nyxlib/nyx-lab/"
    },
    "private": true,
    "type": "module",
    "workspaces": [
        "src-electron"
    ],
    "scripts": {
        "lint": "eslint",
        "app-dev": "npm i --update vue-nyx && vite --port 1234 dev",
        "app-prod": "npm i --update vue-nyx && vite build",
        "app-lint": "eslint",
        "electron-start": "npm i --update vue-nyx && vite build && cd src-electron && npm run electron-start",
        "electron-macos": "npm i --update vue-nyx && vite build && cd src-electron && npm run electron-make-macos",
        "electron-linux": "npm i --update vue-nyx && vite build && cd src-electron && npm run electron-make-linux",
        "electron-windows": "npm i --update vue-nyx && vite build && cd src-electron && npm run electron-make-windows",
        "tauri-dev": "tauri dev",
        "tauri-prod": "tauri build",
        "tauri-android": "tauri android build --target armv7",
        "tauri-android-deploy": "adb install ./src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.10.1",
        "@tauri-apps/plugin-dialog": "^2.6.0",
        "@tauri-apps/plugin-fs": "^2.4.5",
        "@tauri-apps/plugin-geolocation": "^2.3.2",
        "@tauri-apps/plugin-http": "^2.5.7",
        "@tauri-apps/plugin-notification": "^2.3.3",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-shell": "^2.3.5",
        "@tauri-apps/plugin-store": "^2.4.2",
        "@tsparticles/slim": "^3.9.1",
        "@tsparticles/vue3": "^3.0.1",
        "@types/bootstrap": "^5.2.10",
        "@vueform/multiselect": "^2.6.11",
        "air-datepicker": "^3.6.0",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.13.1",
        "chart.js": "^4.5.1",
        "chartjs-adapter-date-fns": "^3.0.0",
        "d3": "^7.9.0",
        "d3-geo-projection": "^4.0.0",
        "d3-selection": "^3.0.0",
        "date-fns": "^4.1.0",
        "echarts": "^5.6.0",
        "echarts-gl": "^2.0.9",
        "gridstack": "^12.6.0",
        "marked": "^17.0.5",
        "pinia": "^3.0.4",
        "sweetalert2": "^11.26.24",
        "uuid": "^14.0.0",
        "vue": "^3.5.32",
        "vue-nyx": "file:../nyx-vue",
        "vue-router": "^5.0.4",
        "vuedraggable": "^4.1.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.10.1",
        "@types/bootstrap": "^5.2.10",
        "@vitejs/plugin-vue": "^6.0.5",
        "eslint": "^10.1.0",
        "eslint-plugin-vue": "^10.8.0",
        "lucide-static": "^1.7.0",
        "sass": "^1.99.0",
        "simple-icons": "^16.14.0",
        "vite": "^8.0.3",
        "vite-plugin-eslint": "^1.8.1"
    }
}
