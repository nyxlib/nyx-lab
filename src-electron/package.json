{
    "name": "nyx-lab",
    "version": "1.0.0",
    "description": "Nyx Lab Desktop",
    "main": "main.js",
    "author": "Jérôme Odier",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "electron-start": "electron .",
        "electron-make-linux": "electron-builder --linux AppImage",
        "electron-make-windows": "electron-builder --win portable"
    },
    "build": {
        "appId": "org.nyxlib.lab",
        "productName": "Nyx Lab Desktop",
        "asar": true,
        "artifactName": "${name}-${version}.${ext}",
        "directories": {
            "output": "target"
        },
        "files": [
            {
                "from": ".",
                "to": ".",
                "filter": [
                    "**/*",
                    "!target/**",
                    "!build-icons.sh"
                ]
            },
            {
                "from": "../dist",
                "to": "dist",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Science",
            "icon": "icons/app-icon.svg"
        },
        "mac": {
            "target": [
                "dmg"
            ],
            "category": "public.app-category.science",
            "icon": "icons/app-icon.icns"
        },
        "win": {
            "target": [
                "portable"
            ],
            "icon": "icons/app-icon.ico"
        }
    },
    "devDependencies": {
        "electron": "41.1.0",
        "electron-builder": "^26.8.1"
    }
}
